<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="20251126000000-1" author="jungsoo">
        <createTable tableName="rate_limit_config">
            <column name="api_key" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="calls_per_second" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="calls_per_minute" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="calls_per_hour" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="calls_per_day" type="bigint">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
